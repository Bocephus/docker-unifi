# Mongo secrets — leave blank in git. Paste the real values directly into
# Portainer's stack "Environment variables" field when deploying instead.
MONGO_INITDB_ROOT_PASSWORD=
MONGO_PASS=

# Mongo, non-secret
MONGO_INITDB_ROOT_USERNAME=root
MONGO_USER=unifi
MONGO_DBNAME=unifi
MONGO_AUTHSOURCE=admin
MONGO_HOST=unifi-db
MONGO_PORT=27017

# unifi-network-application container
PUID=1000
PGID=1000
TZ=America/New_York
# MEM_LIMIT/MEM_STARTUP are optional JVM heap tuning for the controller.
MEM_LIMIT=1024
MEM_STARTUP=1024
